<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appBar"
    android:background="@android:color/transparent"
    style="@style/Widget.Card.MatchWrap">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Widget.Card.layout_weight"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/esewa_logo"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginTop="14dp"
                    android:src="@drawable/market" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/notification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_notify"
                    android:layout_marginEnd="12dp"/>

                <ImageView
                    style="@style/Widget.Card.Wrap"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_overflow_option" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        style="@style/Widget.Card.MatchWrap"
        android:orientation="horizontal"
        android:layout_marginVertical="8dp"
        android:layout_marginStart="16dp">

        <TextView
            style="@style/Widget.Card.Wrap"
            android:textFontWeight="400"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:text="@string/greet" />

        <TextView
            style="@style/Widget.Card.Wrap"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:text="@string/name" />

        <TextView
            style="@style/Widget.Card.Wrap"
            android:textFontWeight="400"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:text="@string/discover" />

    </LinearLayout>

    <LinearLayout
        style="@style/Widget.Card.MatchWrap"
        android:minHeight="45dp"
        android:orientation="horizontal"
        android:background="@drawable/edit_text_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:elevation="4dp">

        <ImageView
            style="@style/Widget.Card.Wrap"
            android:minHeight="24dp"
            android:minWidth="24dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/ic_search"/>

        <EditText
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textFontWeight="400"
            android:textSize="14sp"
            android:autofillHints="What are you searching for?"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:background="@drawable/edit_text_background"/>

        <ImageView
            style="@style/Widget.Card.Wrap"
            android:minHeight="24dp"
            android:minWidth="24dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/ic_slider"/>

    </LinearLayout>

</com.google.android.material.appbar.AppBarLayout>