<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Card.Match"
    android:background="#E6ECF4"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Widget.Card.Match">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpProductImage"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/productDetailBack"
                style="@style/Widget.Card.Wrap"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/ic_back_arrow"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:padding="8dp"
                android:background="@drawable/bg_cart"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_cart"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/imageDotIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabPaddingStart="5dp"
            app:tabPaddingEnd="5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabBackground="@drawable/tab_selector"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@id/vpProductImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            style="@style/Widget.Card.Wrap"
            android:minWidth="56dp"
            android:minHeight="56dp"
            android:padding="16dp"
            android:layout_marginEnd="16dp"
            app:tint="@color/white"
            android:background="@drawable/bg_green_circle"
            android:src="@drawable/ic_favourite"
            app:layout_constraintTop_toBottomOf="@id/vpProductImage"
            app:layout_constraintBottom_toBottomOf="@id/vpProductImage"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="1dp"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:background="@color/white"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vpProductImage">

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_margin="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/productName"
                    style="@style/Widget.Card.Wrap"
                    android:letterSpacing="0.05"
                    android:paddingVertical="2dp"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/productPrice"
                    style="@style/Widget.Card.Wrap"
                    android:letterSpacing="0.1"
                    android:paddingVertical="2dp"
                    android:textSize="24sp" />

                <LinearLayout
                    style="@style/Widget.Card.MatchWrap"
                    android:orientation="horizontal">

                    <TextView
                        android:visibility="invisible"
                        style="@style/Widget.Card.Wrap"
                        android:letterSpacing="0.05"
                        android:paddingVertical="4dp"
                        android:text="Rs.5000.00"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Space style="@style/Widget.Card.layout_weight" />

                    <TextView
                        style="@style/Widget.Card.Wrap"
                        android:letterSpacing="0.025"
                        android:paddingEnd="4dp"
                        android:text="Availability"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/productStock"
                        style="@style/Widget.Card.Wrap"
                        android:textColor="@color/green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="#E6ECF4"
                android:orientation="horizontal" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Card.MatchWrap"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.05"
                    android:text="Description"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/productDescription"
                    style="@style/Widget.Card.MatchWrap"
                    android:letterSpacing="0.05"
                    android:lineHeight="30dp"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/discount_background"
                    android:letterSpacing="0.05"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="VIEW MORE"
                    android:textColor="@color/green" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="#E6ECF4"
                android:orientation="horizontal" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sizeLabel"
                    style="@style/Widget.Card.Wrap"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.05"
                    android:text="Select Size"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSizeOption"
                    style="@style/Widget.Card.MatchWrap"/>

                <TextView
                    android:id="@+id/colorLabel"
                    style="@style/Widget.Card.Wrap"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.05"
                    android:text="Select Color"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/colorRadioBtn"
                    style="@style/Widget.Card.MatchWrap"
                    android:orientation="horizontal">

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:textColor="@drawable/text_radio"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:textColor="@drawable/text_radio"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:textColor="@drawable/text_radio"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:textColor="@drawable/text_radio"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RadioGroup>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_width="match_parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="301dp"
                    android:foreground="@drawable/bg_green_to_blue_overlay"
                    android:scaleType="fitXY"
                    android:src="@drawable/product_detail_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_margin="16dp"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.Card.MatchWrap"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        style="@style/Widget.Card.MatchWrap"
                        app:cardBackgroundColor="#E2E0E0"
                        app:cardCornerRadius="16dp"
                        android:minWidth="136dp"
                        android:minHeight="84dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/ratingBox"
                            android:padding="32dp"
                            style="@style/Widget.Card.MatchWrap">

                            <TextView
                                android:id="@+id/avgRating"
                                style="@style/Widget.Card.Wrap"
                                android:paddingVertical="2dp"
                                android:textSize="34sp"
                                android:letterSpacing="0.05"
                                android:text="4.0"
                                app:layout_constraintStart_toStartOf="@id/ratingBox"
                                app:layout_constraintTop_toTopOf="@id/ratingBox"/>

                            <TextView
                                style="@style/Widget.Card.Wrap"
                                android:text=" /5"
                                android:paddingVertical="2dp"
                                android:letterSpacing="0.05"
                                android:textSize="16sp"
                                app:layout_constraintStart_toEndOf="@id/avgRating"
                                app:layout_constraintBottom_toBottomOf="@id/avgRating"/>

                            <TextView
                                android:id="@+id/basedOn"
                                style="@style/Widget.Card.Wrap"
                                android:textSize="12sp"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold"
                                android:text="Based on "
                                app:layout_constraintTop_toBottomOf="@id/avgRating"
                                app:layout_constraintStart_toStartOf="@id/ratingBox"/>
                            <TextView
                                android:id="@+id/totalReviews"
                                style="@style/Widget.Card.Wrap"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="@color/text_dark"
                                android:text="23"
                                app:layout_constraintTop_toBottomOf="@id/avgRating"
                                app:layout_constraintStart_toEndOf="@id/basedOn"/>
                            <TextView
                                style="@style/Widget.Card.Wrap"
                                android:text=" reviews"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark"
                                app:layout_constraintTop_toBottomOf="@id/avgRating"
                                app:layout_constraintStart_toEndOf="@id/totalReviews"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.cardview.widget.CardView>
                    
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>