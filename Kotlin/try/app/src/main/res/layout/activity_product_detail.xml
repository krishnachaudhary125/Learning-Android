<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Card.Match"
    android:background="#E6ECF4"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Widget.Card.Match"
        android:layout_marginTop="36dp">

        <ImageView
            android:id="@+id/productImage"
            style="@style/Widget.Card.Wrap"
            android:src="@drawable/test_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/productDetailBack"
                style="@style/Widget.Card.Wrap"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/ic_back_arrow"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:padding="8dp"
                android:background="@drawable/bg_cart"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_cart"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

<!--        <com.google.android.material.tabs.TabLayout-->
<!--            android:id="@+id/tabLayoutIndicator"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:minWidth="42dp"-->
<!--            android:background="@android:color/transparent"-->
<!--            android:layout_height="10dp"-->
<!--            android:minHeight="8dp"-->
<!--            android:layout_marginTop="12dp"-->
<!--            android:layout_marginBottom="16dp"-->
<!--            app:tabBackground="@drawable/tab_selector"-->
<!--            app:tabGravity="center"-->
<!--            app:tabIndicatorHeight="0dp"-->
<!--            app:layout_constraintBottom_toBottomOf="@id/productImage"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"/>-->

        <ImageView
            style="@style/Widget.Card.Wrap"
            android:minWidth="56dp"
            android:minHeight="56dp"
            android:padding="16dp"
            android:layout_marginEnd="16dp"
            app:tint="@color/white"
            android:background="@drawable/bg_green_circle"
            android:src="@drawable/ic_favourite"
            app:layout_constraintTop_toBottomOf="@id/productImage"
            app:layout_constraintBottom_toBottomOf="@id/productImage"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="1dp"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:orientation="vertical"
            android:background="@color/white"
            app:layout_constraintTop_toBottomOf="@id/productImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_margin="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:textSize="20sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:paddingVertical="2dp"
                    android:text="Jacket In Nylon"/>

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:textSize="24sp"
                    android:letterSpacing="0.1"
                    android:paddingVertical="2dp"
                    android:text="Rs.2500.00"/>

                <LinearLayout
                    style="@style/Widget.Card.MatchWrap"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.Card.Wrap"
                        android:textSize="14sp"
                        android:paddingVertical="4dp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:text="Rs.5000.00"/>

                    <Space style="@style/Widget.Card.layout_weight"/>

                    <TextView
                        style="@style/Widget.Card.Wrap"
                        android:textSize="10sp"
                        android:paddingEnd="4dp"
                        android:letterSpacing="0.025"
                        android:text="Availability"/>

                    <TextView
                        style="@style/Widget.Card.Wrap"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/green"
                        android:text="In Stock"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:background="#E6ECF4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"/>

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Card.MatchWrap"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:text="Description"/>

                <TextView
                    style="@style/Widget.Card.MatchWrap"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:lineHeight="30dp"
                    android:letterSpacing="0.05"
                    android:text="✅\tApprox. model measurements: height:5’10”, bust: 31-1/2”, waist: 24”\n✅\tHits at hip\n✅\tV-neck\n✅\tCreated for Macy’s\n✅\tCreated for Macy’s\n✅\tCreated for Macy’s\n✅\tCreated for Macy’s\n✅\tCreated for Macy’s"/>

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:letterSpacing="0.05"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/green"
                    android:background="@drawable/discount_background"
                    android:layout_gravity="center"
                    android:text="VIEW MORE" />

            </LinearLayout>

            <LinearLayout
                android:background="#E6ECF4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"/>

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_dark"
                    android:text="Select Size"/>

                <RadioGroup
                    style="@style/Widget.Card.MatchWrap"
                    android:orientation="horizontal">

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:text="S"/>

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:text="M"/>

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:text="L"/>

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"
                        android:text="XL"/>

                </RadioGroup>

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_dark"
                    android:text="Select Color"/>

                <RadioGroup
                    style="@style/Widget.Card.MatchWrap"
                    android:orientation="horizontal">

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"/>

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"/>

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"/>

                    <RadioButton
                        style="@style/Widget.Card.Wrap"
                        android:minHeight="32dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@drawable/text_radio"
                        android:gravity="center"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@android:color/transparent"/>

                </RadioGroup>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>