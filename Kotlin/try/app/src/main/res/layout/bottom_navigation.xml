<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F9FBFE"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd = "24dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/shopButton"
            android:layout_gravity="center"
            android:gravity="center"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/navigation_background"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/shopIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_shop_selected"/>

            <TextView
                android:id="@+id/shopLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:textColor="@color/green"
                android:textFontWeight="600"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cartButton"
            android:background="@android:color/transparent"
            android:layout_gravity="center"
            android:gravity="center"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cartIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_cart"/>

            <TextView
                android:id="@+id/cartLabel"
                android:textColor="@color/green"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favouriteButton"
            android:background="@android:color/transparent"
            android:layout_gravity="center"
            android:gravity="center"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/favouriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_favourite"/>

            <TextView
                android:id="@+id/favouriteLabel"
                android:textColor="@color/green"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favourite"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/moreButon"
            android:background="@android:color/transparent"
            android:layout_gravity="center"
            android:gravity="center"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/moreIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_more"/>

            <TextView
                android:id="@+id/moreLabel"
                android:textColor="@color/green"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>