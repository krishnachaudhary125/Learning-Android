<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Card.Match"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#E6ECF4">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/shopScrollLayer"
        style="@style/Widget.Card.Match"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/toolBar"
        style="@style/Widget.Card.MatchWrap"
        android:orientation="vertical">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical">

           <LinearLayout
               style="@style/Widget.Card.MatchWrap"
               android:baselineAligned="false"
               android:orientation="horizontal">
               
               <LinearLayout
                   style="@style/Widget.Card.layout_weight"
                   android:orientation="horizontal"
                   android:layout_marginTop="16dp"
                   android:layout_marginStart="16dp">
    
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/esewa_logo"/>

                   <ImageView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="7dp"
                       android:layout_marginTop="14dp"
                       android:src="@drawable/market" />
    
               </LinearLayout>
    
               <LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:layout_marginTop="16dp"
                   android:layout_marginEnd="16dp">
    
                   <ImageView
                       android:id="@+id/notification"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:src="@drawable/ic_notify"
                       android:layout_marginEnd="12dp"/>
    
                   <ImageView
                       style="@style/Widget.Card.Wrap"
                       android:layout_marginStart="12dp"
                       android:src="@drawable/ic_overflow_option" />
               </LinearLayout>

           </LinearLayout>

           <LinearLayout
               style="@style/Widget.Card.MatchWrap"
               android:orientation="horizontal"
               android:layout_marginStart="16dp"
               android:layout_marginTop="20dp">

               <TextView
                   style="@style/Widget.Card.Wrap"
                   android:textFontWeight="400"
                   android:textSize="10sp"
                   android:letterSpacing="0.04"
                   android:text="@string/greet" />

               <TextView
                   style="@style/Widget.Card.Wrap"
                   android:textStyle="bold"
                   android:layout_marginHorizontal="2dp"
                   android:textSize="10sp"
                   android:letterSpacing="0.04"
                   android:text="@string/name" />

               <TextView
                   style="@style/Widget.Card.Wrap"
                   android:textFontWeight="400"
                   android:textSize="10sp"
                   android:letterSpacing="0.04"
                   android:text="@string/discover" />

           </LinearLayout>

           <LinearLayout
               style="@style/Widget.Card.MatchWrap"
               android:minHeight="45dp"
               android:orientation="horizontal"
               android:background="@drawable/edit_text_background"
               android:layout_marginStart="16dp"
               android:layout_marginEnd="16dp"
               android:layout_marginTop="14dp"
               android:gravity="center"
               android:elevation="4dp">

               <ImageView
                   style="@style/Widget.Card.Wrap"
                   android:minHeight="24dp"
                   android:minWidth="24dp"
                   android:layout_marginHorizontal="16dp"
                   android:src="@drawable/ic_search"/>

               <EditText
                   android:layout_width="0dp"
                   android:layout_weight="1"
                   android:layout_height="wrap_content"
                   android:textFontWeight="400"
                   android:textSize="14sp"
                   android:autofillHints="What are you searching for?"
                   android:hint="@string/search_hint"
                   android:inputType="text"
                   android:background="@drawable/edit_text_background"/>

               <ImageView
                   style="@style/Widget.Card.Wrap"
                   android:minHeight="24dp"
                   android:minWidth="24dp"
                   android:layout_marginHorizontal="16dp"
                   android:src="@drawable/ic_slider"/>

           </LinearLayout>

       </LinearLayout>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpBanner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minHeight="160dp"
                    android:orientation="horizontal"
                    android:scrollbars="none"
                    app:layout_constraintDimensionRatio="2:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutIndicator"
                style="@style/Widget.Card.Wrap"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="5dp"
                app:tabPaddingStart="5dp" />

        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.Card.Wrap"
                android:text="@string/categories"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Space style="@style/Widget.Card.layout_weight"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:minWidth="46dp"
                android:minHeight="24dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/transparent_background"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerView"
            style="@style/Widget.Card.Wrap"
            android:minHeight="85dp"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:scrollbars="none"
            android:layout_marginTop="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.Card.Wrap"
                android:text="@string/featured"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Space style="@style/Widget.Card.layout_weight"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:minWidth="46dp"
                android:minHeight="24dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/transparent_background"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeaturedProduct"
            style="@style/Widget.Card.Match"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.Card.Wrap"
                android:text="@string/hot_deal"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Space style="@style/Widget.Card.layout_weight"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:minWidth="46dp"
                android:minHeight="24dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/transparent_background"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHotDealProduct"
            style="@style/Widget.Card.Match"/>
        
        <ImageView
            style="@style/Widget.Card.Wrap"
            android:layout_marginTop="24dp"
            android:scaleType="fitCenter"
            android:layout_marginHorizontal="24dp"
            android:src="@drawable/benchmark"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginTop="36dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp">

            <TextView
                style="@style/Widget.Card.Wrap"
                android:textStyle="bold"
                android:textSize="16sp"
                android:text="Most Popular"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hotDealCategoriesRecyclerView"
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginHorizontal="16dp"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.Card.Wrap"
                android:text="@string/popular"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Space style="@style/Widget.Card.layout_weight"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:minWidth="46dp"
                android:minHeight="24dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/transparent_background"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPopularBrand"
            style="@style/Widget.Card.Match"/>

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.Card.Wrap"
                android:text="@string/recommended"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Space style="@style/Widget.Card.layout_weight"/>

            <ImageView
                style="@style/Widget.Card.Wrap"
                android:minWidth="46dp"
                android:minHeight="24dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/transparent_background"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecommended"
            style="@style/Widget.Card.Match"/>

        <LinearLayout
            style="@style/Widget.Card.Wrap"
            android:layout_marginBottom="78dp"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/loadingGif"
                style="@style/Widget.Card.Wrap"
                android:minWidth="64dp"
                android:minHeight="64dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"/>

            <TextView
                style="@style/Widget.Card.Wrap"
                android:layout_gravity="center"
                android:textSize="10sp"
                android:text="@string/loading"/>

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/floatingSellButton"
        style="@style/Widget.Card.Wrap"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_sell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            style="@style/Widget.Card.Wrap"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:layout_marginVertical="12dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_sell"/>

        <TextView
            android:id="@+id/floatingSell"
            style="@style/Widget.Card.Wrap"
            android:maxHeight="16dp"
            android:paddingStart="6dp"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginEnd="16dp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/white"
            android:text="@string/sell_btn"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>